{
  "expo": {
    "name": "Rungorizer",
    "slug": "rungorizer",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "rungorizer",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runterya.rungorizer",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.runterya.rungorizer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#007AFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-share-intent",
        {
          "disableAndroid": true,
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          }
        }
      ],
      "./plugins/withShareActivity"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
